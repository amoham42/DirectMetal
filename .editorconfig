root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4

[*.{sh,yml,yaml,json,plist,entitlements,sb,tmpl}]
indent_style = space
indent_size = 2

[*.{swift,c,h,cpp,hpp,mm,py,hlsl}]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
